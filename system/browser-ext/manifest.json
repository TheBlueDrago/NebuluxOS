{
  "manifest_version": 3,
  "name": "Nebulux OS web windows",
  "version": "1.0",
  "description": "Lets Nebulux OS show websites inside its own windows, and keeps pop-ups inside the OS.",
  "permissions": ["declarativeNetRequest", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "declarative_net_request": { "rule_resources": [{ "id": "frames", "enabled": true, "path": "rules.json" }] },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "all_frames": true, "run_at": "document_start", "js": ["frame.js"] }
  ]
}
