# Nebulux OS system packages (Debian 12). The Linux kernel (linux-image-amd64) comes from bookworm-backports (see
# build.sh), and so does the firmware below when backports has a newer one.

# firmware: Wi-Fi and Bluetooth (Realtek, Intel, Atheros/Qualcomm, Broadcom), graphics and sound. More optional
# firmware (MediaTek and the newer split packages) is added by nebulux.hook.chroot when it exists.
firmware-linux-free
firmware-misc-nonfree
firmware-realtek
firmware-iwlwifi
firmware-atheros
firmware-brcm80211
firmware-amd-graphics
firmware-sof-signed
amd64-microcode
intel-microcode

# starting up from the USB
live-boot
live-config
live-config-systemd
systemd-sysv
libpam-systemd
dbus-user-session
user-setup
sudo
procps
locales
keyboard-configuration
console-setup
plymouth
plymouth-themes
intel-microcode
amd64-microcode

# the screen
xserver-xorg-core
xserver-xorg-video-all
xserver-xorg-input-all
xinit
x11-xserver-utils
mesa-utils
libgl1-mesa-dri

# the browser engine Nebulux OS runs in, and fonts
chromium
chromium-sandbox
fonts-dejavu-core
fonts-liberation2
fonts-noto-core
fonts-inter
fonts-noto-color-emoji

# the system helper
nodejs

