#!/bin/sh
# Runs inside the Nebulux OS system while the .iso is built.
set -e
V="$(cat /opt/nebulux/VERSION 2>/dev/null || echo 1.0)"

# optional firmware: newer Debian splits firmware into more packages (MediaTek Wi-Fi such as the MT7921/MT7922,
# Intel graphics and sound, and more). Each is added when it exists; a missing one is simply skipped.
for p in firmware-mediatek firmware-intel-graphics firmware-intel-misc firmware-intel-sound firmware-libertas firmware-ti-connectivity firmware-cirrus firmware-qcom-soc; do
  if apt-cache show "$p" >/dev/null 2>&1; then DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends "$p" >/dev/null 2>&1 && echo "firmware: added $p" || echo "firmware: skipped $p"; fi
done

# the system's name
cat > /etc/os-release <<OSR
PRETTY_NAME="Nebulux OS $V"
NAME="Nebulux OS"
VERSION_ID="$V"
VERSION="$V"
VERSION_CODENAME=bookworm
ID=debian
HOME_URL="https://nebuluxai.com/"
OSR
echo "Nebulux OS $V" > /etc/issue; echo "Nebulux OS $V" > /etc/issue.net; : > /etc/motd

chmod 755 /usr/local/bin/nebulux-session
# the network troubleshooter's fixes: run by root, allowed without a password, and nothing else
chown root:root /usr/local/sbin/nebulux-netfix /etc/sudoers.d/nebulux-netfix
chmod 755 /usr/local/sbin/nebulux-netfix
chmod 440 /etc/sudoers.d/nebulux-netfix
visudo -cf /etc/sudoers.d/nebulux-netfix
chmod -R a+rX /opt/nebulux

# start-up picture: the Nebulux OS logo with a spinner
plymouth-set-default-theme nebulux 2>/dev/null || plymouth-set-default-theme bgrt 2>/dev/null || plymouth-set-default-theme spinner 2>/dev/null || true

# Nebulux OS opens on the screen by itself (no text login)
systemctl enable nebulux-screen.service
systemctl mask getty@tty1.service 2>/dev/null || true

# a fast start-up: nothing waits for a network, and no background upkeep jobs run on a USB system
systemctl mask NetworkManager-wait-online.service 2>/dev/null || true
for t in apt-daily.timer apt-daily-upgrade.timer man-db.timer e2scrub_all.timer e2scrub_reap.service fstrim.timer logrotate.timer dpkg-db-backup.timer; do systemctl mask "$t" 2>/dev/null || true; done
systemctl enable NetworkManager.service bluetooth.service systemd-timesyncd.service udisks2.service 2>/dev/null || true
# a short journal kept in memory
mkdir -p /etc/systemd/journald.conf.d; printf '[Journal]\nStorage=volatile\nRuntimeMaxUse=32M\n' > /etc/systemd/journald.conf.d/nebulux.conf

# Bluetooth turns on when there's a Bluetooth chip
if [ -f /etc/bluetooth/main.conf ]; then sed -i 's/^#\?AutoEnable=.*/AutoEnable=true/' /etc/bluetooth/main.conf; fi

# brightness without a password for the signed-in person
cat > /etc/udev/rules.d/90-nebulux-backlight.rules <<UDEV
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"
UDEV

# Wi-Fi, Bluetooth and power controls are allowed for the person at the computer
mkdir -p /etc/polkit-1/rules.d
cat > /etc/polkit-1/rules.d/50-nebulux.rules <<PK
polkit.addRule(function(action, subject) {
  if (subject.user == "nebulux" && subject.local && (
      action.id.indexOf("org.freedesktop.NetworkManager.") == 0 ||
      action.id.indexOf("org.freedesktop.login1.power-off") == 0 ||
      action.id.indexOf("org.freedesktop.login1.reboot") == 0 ||
      action.id.indexOf("org.freedesktop.login1.suspend") == 0 ||
      action.id == "org.freedesktop.udisks2.filesystem-mount" || action.id == "org.freedesktop.udisks2.filesystem-unmount-others" ||
      action.id == "org.freedesktop.udisks2.eject-media" || action.id == "org.freedesktop.udisks2.power-off-drive")) return polkit.Result.YES;
});
PK

# the rebuilt start-up files pick up the start-up picture
update-initramfs -u -k all
