#!/bin/bash
# The Nebulux OS session: the system helper, then Nebulux OS full screen in the built-in browser engine.
# If the browser engine ever closes, or the OS page doesn't load within 45 seconds, it starts again by itself.
xset s off -dpms s noblank 2>/dev/null
mkdir -p "$HOME/Downloads"
P="$HOME/.config/nebulux-browser"
# The web-windows extension goes in a folder the browser engine can write to: it keeps an index of its rules next to
# them, and /opt/nebulux is part of the read-only system (it silently didn't load from there in 1.1 and 1.2).
EXT="$HOME/.local/share/nebulux-ext"
rm -rf "$EXT"; mkdir -p "$(dirname "$EXT")"; cp -r /opt/nebulux/ext "$EXT"

# Graphics: drawn without the graphics chip's acceleration, which works on every computer (some chips showed only a
# white screen with it). To try acceleration, make the file /etc/nebulux/use-gpu.
GPU="--disable-gpu --disable-gpu-compositing"
[ -f /etc/nebulux/use-gpu ] && GPU="--ignore-gpu-blocklist"
export NX_BROWSER_FLAGS="$GPU"

# the window manager: Nebulux OS underneath, real web browser windows above it (above the taskbar)
pkill -u "$(id -u)" -x openbox 2>/dev/null
openbox --config-file /etc/nebulux/openbox.xml >/dev/null 2>&1 &
sleep 0.3

# the system helper (Wi-Fi, Bluetooth, files, screens, sound, power) on 127.0.0.1:7777
helper_up() { (echo >/dev/tcp/127.0.0.1/7777) 2>/dev/null; }
start_helper() {
  pkill -u "$(id -u)" -f nebulux-helper.js 2>/dev/null
  node /opt/nebulux/helper/nebulux-helper.js /opt/nebulux/www >"$HOME/.nebulux-helper.log" 2>&1 &
  for _ in $(seq 1 200); do helper_up && return 0; sleep 0.1; done
  return 1
}
start_helper


while true; do
  helper_up || start_helper
  # the whole screen: there is no window manager, so the browser is told the screen size itself
  read -r W H < <(xrandr 2>/dev/null | awk '/\*/{split($1,a,"x"); print a[1], a[2]; exit}')
  [ -n "$W" ] || { W=1280; H=800; }
  # never show "restore pages?" after the power was cut
  sed -i 's/"exited_cleanly":false/"exited_cleanly":true/; s/"exit_type":"[^"]*"/"exit_type":"Normal"/' "$P/Default/Preferences" 2>/dev/null
  START=$(date +%s)
  chromium --class=NebuluxShell --kiosk --no-first-run --no-default-browser-check --noerrdialogs --disable-infobars \
    --disable-session-crashed-bubble --disable-features=Translate,PasswordManagerOnboarding,DisableLoadExtensionCommandLineSwitch,MediaRouter,OptimizationHints,InterestFeedContentSuggestions,CalculateNativeWinOcclusion,HeavyAdIntervention \
    --disable-background-networking --disable-component-update --disable-sync --no-pings --disable-breakpad --disable-domain-reliability --metrics-recording-only --disable-client-side-phishing-detection \
    --password-store=basic --user-data-dir="$P" --load-extension="$EXT" $GPU \
    --window-position=0,0 --window-size="$W,$H" --start-fullscreen --check-for-update-interval=31536000 --overscroll-history-navigation=0 \
    --autoplay-policy=no-user-gesture-required \
    "http://127.0.0.1:7777/" >"$HOME/.nebulux-browser.log" 2>&1 &
  CPID=$!
  # the watchdog: the OS page talks to the helper all the time; if it hasn't within 45 seconds, start over
  ( sleep 45
    A=$(stat -c %Y "$HOME/.nebulux-alive" 2>/dev/null || echo 0)
    if [ "$A" -lt "$START" ]; then echo "$(date) the OS page didn't load; starting again" >>"$HOME/.nebulux-browser.log"; start_helper; kill "$CPID" 2>/dev/null; fi ) &
  WD=$!
  wait "$CPID"
  kill "$WD" 2>/dev/null
  sleep 1
done
