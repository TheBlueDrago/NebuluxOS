# The Nebulux OS start-up screen: the night-sky color, the logo in the middle and a spinner under it.
Window.SetBackgroundTopColor(0.06, 0.03, 0.16);
Window.SetBackgroundBottomColor(0.03, 0.02, 0.08);
logo = Image("logo.png");
logo_sprite = Sprite(logo);
logo_sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.GetWidth() / 2);
logo_sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.GetHeight() / 2 - 40);
spinner = Image("spinner.png");
spin_sprite = Sprite();
angle = 0;
fun refresh() {
  angle = angle + 0.14;
  turned = spinner.Rotate(angle);
  spin_sprite.SetImage(turned);
  spin_sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - turned.GetWidth() / 2);
  spin_sprite.SetY(Window.GetY() + Window.GetHeight() / 2 + 90 - turned.GetHeight() / 2);
}
Plymouth.SetRefreshFunction(refresh);
# no password questions or messages on this screen
fun quiet_message(text) { }
Plymouth.SetMessageFunction(quiet_message);
