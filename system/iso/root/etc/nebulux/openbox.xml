<?xml version="1.0" encoding="UTF-8"?>
<!-- Nebulux OS window manager settings (Openbox). Nebulux OS itself (NebuluxShell) fills the screen underneath.
     Web browser windows (NebuluxWeb) open maximized above it, stopping above the 48 px Nebulux taskbar so it always
     shows. No title bars: the browser draws its own tabs and buttons. The Windows-key shortcuts are caught here and passed to Nebulux OS, so they work over every window. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <resistance><strength>10</strength><screen_edge_strength>20</screen_edge_strength></resistance>
  <focus><focusNew>yes</focusNew><followMouse>no</followMouse><raiseOnFocus>no</raiseOnFocus></focus>
  <placement><policy>Smart</policy><center>yes</center></placement>
  <theme><name>Nebulux</name><titleLayout>NLIMC</titleLayout><keepBorder>yes</keepBorder><animateIconify>no</animateIconify>
    <font place="ActiveWindow"><name>Inter</name><size>10</size><weight>Normal</weight></font>
    <font place="InactiveWindow"><name>Inter</name><size>10</size><weight>Normal</weight></font></theme>
  <desktops><number>1</number><firstdesk>1</firstdesk><popupTime>0</popupTime></desktops>
  <margins><top>0</top><bottom>48</bottom><left>0</left><right>0</right></margins>
  <keyboard>
    <keybind key="Super_L"><action name="Execute"><command>/usr/local/bin/nebulux-key start</command></action></keybind>
    <keybind key="Super_R"><action name="Execute"><command>/usr/local/bin/nebulux-key start</command></action></keybind>
    <keybind key="W-d"><action name="Execute"><command>/usr/local/bin/nebulux-key desk</command></action></keybind>
    <keybind key="W-e"><action name="Execute"><command>/usr/local/bin/nebulux-key files</command></action></keybind>
    <keybind key="W-a"><action name="Execute"><command>/usr/local/bin/nebulux-key qs</command></action></keybind>
    <keybind key="W-i"><action name="Execute"><command>/usr/local/bin/nebulux-key settings</command></action></keybind>
    <keybind key="W-n"><action name="Execute"><command>/usr/local/bin/nebulux-key notif</command></action></keybind>
    <keybind key="W-u"><action name="Execute"><command>/usr/local/bin/nebulux-key access</command></action></keybind>
    <keybind key="W-x"><action name="Execute"><command>/usr/local/bin/nebulux-key xmenu</command></action></keybind>
    <keybind key="W-r"><action name="Execute"><command>/usr/local/bin/nebulux-key run</command></action></keybind>
    <keybind key="W-p"><action name="Execute"><command>/usr/local/bin/nebulux-key project</command></action></keybind>
    <keybind key="W-k"><action name="Execute"><command>/usr/local/bin/nebulux-key cast</command></action></keybind>
    <keybind key="C-W-c"><action name="Execute"><command>/usr/local/bin/nebulux-key cfilter</command></action></keybind>
    <keybind key="W-Pause"><action name="Execute"><command>/usr/local/bin/nebulux-key about</command></action></keybind>
    <keybind key="W-l"><action name="Execute"><command>/usr/local/bin/nebulux-key lock</command></action></keybind>
    <keybind key="W-Tab"><action name="Execute"><command>/usr/local/bin/nebulux-key tview</command></action></keybind>
    <keybind key="W-v"><action name="Execute"><command>/usr/local/bin/nebulux-key clip</command></action></keybind>
    <keybind key="C-W-Left"><action name="Execute"><command>/usr/local/bin/nebulux-key desk-prev</command></action></keybind>
    <keybind key="C-W-Right"><action name="Execute"><command>/usr/local/bin/nebulux-key desk-next</command></action></keybind>
    <keybind key="C-W-d"><action name="Execute"><command>/usr/local/bin/nebulux-key desk-new</command></action></keybind>
    <keybind key="W-period"><action name="Execute"><command>/usr/local/bin/nebulux-key symbols</command></action></keybind>
    <keybind key="W-m"><action name="Execute"><command>/usr/local/bin/nebulux-key minall</command></action></keybind>
    <keybind key="W-S-m"><action name="Execute"><command>/usr/local/bin/nebulux-key restoreall</command></action></keybind>
    <keybind key="W-Home"><action name="Execute"><command>/usr/local/bin/nebulux-key home</command></action></keybind>
    <keybind key="W-t"><action name="Execute"><command>/usr/local/bin/nebulux-key tbar</command></action></keybind>
    <keybind key="W-b"><action name="Execute"><command>/usr/local/bin/nebulux-key tray</command></action></keybind>
    <keybind key="C-W-o"><action name="Execute"><command>/usr/local/bin/nebulux-key osk</command></action></keybind>
    <keybind key="C-W-Return"><action name="Execute"><command>/usr/local/bin/nebulux-key narrator</command></action></keybind>
    <keybind key="C-W-F4"><action name="Execute"><command>/usr/local/bin/nebulux-key desk-close</command></action></keybind>
    <keybind key="XF86AudioRaiseVolume"><action name="Execute"><command>/usr/local/bin/nebulux-key vol-up</command></action></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute"><command>/usr/local/bin/nebulux-key vol-down</command></action></keybind>
    <keybind key="XF86AudioMute"><action name="Execute"><command>/usr/local/bin/nebulux-key mute</command></action></keybind>
    <keybind key="XF86AudioMicMute"><action name="Execute"><command>/usr/local/bin/nebulux-key mic-mute</command></action></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute"><command>/usr/local/bin/nebulux-key bright-up</command></action></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute"><command>/usr/local/bin/nebulux-key bright-down</command></action></keybind>
    <keybind key="W-1"><action name="Execute"><command>/usr/local/bin/nebulux-key app-1</command></action></keybind>
    <keybind key="W-2"><action name="Execute"><command>/usr/local/bin/nebulux-key app-2</command></action></keybind>
    <keybind key="W-3"><action name="Execute"><command>/usr/local/bin/nebulux-key app-3</command></action></keybind>
    <keybind key="W-4"><action name="Execute"><command>/usr/local/bin/nebulux-key app-4</command></action></keybind>
    <keybind key="W-5"><action name="Execute"><command>/usr/local/bin/nebulux-key app-5</command></action></keybind>
    <keybind key="W-6"><action name="Execute"><command>/usr/local/bin/nebulux-key app-6</command></action></keybind>
    <keybind key="W-7"><action name="Execute"><command>/usr/local/bin/nebulux-key app-7</command></action></keybind>
    <keybind key="W-8"><action name="Execute"><command>/usr/local/bin/nebulux-key app-8</command></action></keybind>
    <keybind key="W-9"><action name="Execute"><command>/usr/local/bin/nebulux-key app-9</command></action></keybind>
    <keybind key="W-w"><action name="Execute"><command>/usr/local/bin/nebulux-key widgets</command></action></keybind>
    <keybind key="W-Left"><action name="Execute"><command>/usr/local/bin/nebulux-key snap-left</command></action></keybind>
    <keybind key="W-Right"><action name="Execute"><command>/usr/local/bin/nebulux-key snap-right</command></action></keybind>
    <keybind key="W-Up"><action name="Execute"><command>/usr/local/bin/nebulux-key snap-max</command></action></keybind>
    <keybind key="W-Down"><action name="Execute"><command>/usr/local/bin/nebulux-key snap-down</command></action></keybind>
    <keybind key="Print"><action name="Execute"><command>/usr/local/bin/nebulux-key shot</command></action></keybind>
    <keybind key="W-S-c"><action name="Execute"><command>/usr/local/bin/nebulux-key color</command></action></keybind>
    <keybind key="W-S-s"><action name="Execute"><command>/usr/local/bin/nebulux-key snip</command></action></keybind>
    <keybind key="W-space"><action name="Execute"><command>/usr/local/bin/nebulux-key search</command></action></keybind>
    <keybind key="W-g"><action name="Execute"><command>/usr/local/bin/nebulux-key grid</command></action></keybind>
    <keybind key="W-equal"><action name="Execute"><command>/usr/local/bin/nebulux-key zoom-in</command></action></keybind>
    <keybind key="W-plus"><action name="Execute"><command>/usr/local/bin/nebulux-key zoom-in</command></action></keybind>
    <keybind key="W-minus"><action name="Execute"><command>/usr/local/bin/nebulux-key zoom-out</command></action></keybind>
    <keybind key="W-Escape"><action name="Execute"><command>/usr/local/bin/nebulux-key zoom-off</command></action></keybind>
    <keybind key="A-F4"><action name="Execute"><command>/usr/local/bin/nebulux-key close</command></action></keybind>
    <keybind key="W-z"><action name="Execute"><command>/usr/local/bin/nebulux-key snapz</command></action></keybind>
    <keybind key="C-A-Delete"><action name="Execute"><command>/usr/local/bin/nebulux-key sec</command></action></keybind>
    <keybind key="W-slash"><action name="Execute"><command>/usr/local/bin/nebulux-key keys</command></action></keybind>
    <keybind key="C-S-Escape"><action name="Execute"><command>/usr/local/bin/nebulux-key tm</command></action></keybind>
  </keyboard>
  <mouse>
    <dragThreshold>4</dragThreshold><doubleClickTime>500</doubleClickTime>
    <context name="Client"><mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind><mousebind button="Right" action="Press"><action name="Focus"/></mousebind></context>
    <context name="Titlebar"><mousebind button="Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind><mousebind button="Left" action="Drag"><action name="Move"/></mousebind><mousebind button="Left" action="DoubleClick"><action name="ToggleMaximize"/></mousebind></context>
    <context name="Iconify"><mousebind button="Left" action="Click"><action name="Iconify"/></mousebind></context>
    <context name="Maximize"><mousebind button="Left" action="Click"><action name="ToggleMaximize"/></mousebind></context>
    <context name="Close"><mousebind button="Left" action="Click"><action name="Close"/></mousebind></context>
    <context name="Top Right Bottom Left TRCorner BRCorner TLCorner BLCorner"><mousebind button="Left" action="Drag"><action name="Resize"/></mousebind></context>
  </mouse>
  <applications>
    <application class="NebuluxShell">
      <decor>no</decor><fullscreen>yes</fullscreen><focus>yes</focus><skip_taskbar>yes</skip_taskbar><skip_pager>yes</skip_pager>
    </application>
    <!-- app windows (Store web apps) and real apps get a Nebulux title bar with minimize, maximize/restore and close -->
    <application class="*"><decor>yes</decor><focus>yes</focus></application>
    <application class="NebuluxWeb"><decor>yes</decor><maximized>yes</maximized><layer>normal</layer><focus>yes</focus></application>
    <!-- the web browser itself draws its own tabs and buttons -->
    <application class="NebuluxWeb" name="chromium"><decor>no</decor></application>
    <!-- Nebulux OS itself is on every desktop (the Nebulux desktops are switched with wmctrl by the helper) -->
    <application class="NebuluxShell"><decor>no</decor><fullscreen>yes</fullscreen><desktop>all</desktop></application>
  </applications>
</openbox_config>
